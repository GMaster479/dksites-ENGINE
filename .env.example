# ─────────────────────────────────────────────────────────────
# DK Sites Preview Pipeline — environment
# Copy this file to ".env" and fill in your keys. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Anthropic (required) — buy prepaid credits at https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Places API (New) (required for real extraction)
# Enable "Places API (New)" in Google Cloud Console, then create an API key.
GOOGLE_PLACES_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Yelp Fusion (optional — extra gallery photos). https://www.yelp.com/developers
YELP_API_KEY=

# ─── Model routing (sensible defaults; override only if you want) ───
# Design + code generation -> Sonnet (good quality/$). Triage -> Haiku (cheap).
BRAND_MODEL=claude-sonnet-4-6
GEN_MODEL=claude-sonnet-4-6
TRIAGE_MODEL=claude-haiku-4-5-20251001

# ─── Output / preview ───
PREVIEW_BASE_URL=http://localhost:8787
PREVIEW_DIR=./previews
PORT=8787

# ─── Cloudflare / R2 (hosting + launch) ───
CF_ACCOUNT_ID=0962e78c0be3ec83f4243dd144c58e5f
CF_ZONE_ID=66df50467c15d19fa40a477cc9a65b57
CF_API_TOKEN=            # secret — Workers + R2 + custom-hostname scope (for launch flow)
R2_BUCKET=dksites-previews
R2_ACCESS_KEY_ID=        # secret — Cloudflare R2 → Manage R2 API Tokens
R2_SECRET_ACCESS_KEY=    # secret
PREVIEW_HOST=dksites.com

# ─── Namecheap (domain registration) ───
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=       # secret
NAMECHEAP_USERNAME=      # usually same as API_USER; leave blank to default to it
NAMECHEAP_CLIENT_IP=172.210.53.226   # MUST be the whitelisted IP (curl ifconfig.me)
NAMECHEAP_DEFAULT_PRICE=13.98        # fallback domain price if pricing lookup misses

# ─── Stripe (payment) ───
STRIPE_SECRET_KEY=       # secret — use sk_test_... while building
STRIPE_WEBHOOK_SECRET=   # secret — from `stripe listen` (Phase 3)

# ─── Pricing model ───
HOSTING_PRICE_YEAR=99
APP_FEE_RATE=0.30

# ─── Launch safety ───
# false (default) = dry-run: webhook runs the full sequence but registers/charges NOTHING.
# true            = LIVE: real domain registration + provisioning. Flip only when ready.
LAUNCH_LIVE=false
